# dependencies
node_modules/

# build output
dist/
dist-ssr/
*.local

# vite cache
.vite/

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# test artifacts and logs
artifacts/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files
.env
.env.*
!.env.example

# temporary files (editors/agents write through sidecar temp dirs)
*.tmp
*.tmpdir/
.tmp-build/
# исходники спрайтов и бэкапы генератора (восстанавливаются скриптами, ~20 МБ)
assets/source/generated/
# python-кэш скриптов
scripts/__pycache__/
*.pyc
# рабочие каталоги сборки/отладки
.tmp/
